msgctxt "Addon Summary"
msgid "Arcade (MAME 2010)"
msgstr "Arkáda (MAME 2010)"

msgctxt "Addon Description"
msgid "Late 2010 version of MAME (0.139) for libretro. Compatible with MAME 0.139 sets."
msgstr "Verze MAME z konce roku 2010 (0.139) pro Libretro. Kompatibilní se sadami MAME 0.139."

msgctxt "#30001"
msgid "XY device type (Restart)"
msgstr "Typ zařízení X/Y (vyžaduje restart)"

msgctxt "#30002"
msgid "Video approach 1 Enabled"
msgstr "Povolit video metodu 1"

msgctxt "#30003"
msgid "Hide nag screen"
msgstr "Skrýt úvodní upozornění"

msgctxt "#30004"
msgid "Hide game info screen"
msgstr "Skrýt obrazovku s informacemi o hře"

msgctxt "#30005"
msgid "Hide warning screen"
msgstr "Skrýt obrazovku s varováním"

msgctxt "#30006"
msgid "Core provided aspect ratio"
msgstr "Poměr stran poskytovaný jádrem"

msgctxt "#30007"
msgid "Enable autofire"
msgstr "Povolit automatickou střelbu"

msgctxt "#30008"
msgid "Set autofire pulse speed"
msgstr "Nastavit rychlost pulzů automatické střelby"

msgctxt "#30009"
msgid "Set frameskip"
msgstr "Nastavit přeskakování snímků"

msgctxt "#30010"
msgid "Set sample rate (Restart)"
msgstr "Nastavit vzorkovací frekvenci (vyžaduje restart)"

msgctxt "#30011"
msgid "Set brightness"
msgstr "Nastavit jas"

msgctxt "#30012"
msgid "Set contrast"
msgstr "Nastavit kontrast"

msgctxt "#30013"
msgid "Set gamma"
msgstr "Nastavit gamu"

msgctxt "#30014"
msgid "Use external hiscore.dat"
msgstr "Použít externí hiscore.dat"

msgctxt "#30015"
msgid "Enable multithreading (Restart)"
msgstr "Povolit vícevláknové zpracování (vyžaduje restart)"

msgctxt "#30016"
msgid "QSound HLE spatial filter (Restart)"
msgstr "Prostorový filtr HLE QSound (vyžaduje restart)"
